{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskManager",
  "version": "0.1.30",

  "identifier": "com.taskmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TaskManager",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://jfodsivsowybgbdjtukv.supabase.co wss://jfodsivsowybgbdjtukv.supabase.co; img-src 'self' asset: https://asset.localhost blob: data: https://jfodsivsowybgbdjtukv.supabase.co; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval';",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExMjlDNzVENDcxNzBBNTYKUldSV0NoZEhYY2Nwb1lSaXVYRE1EQXJyd0RXWVR0WFJwNCtYTXc0Uk0rM2tQSmhNWVRBU043elgK",
      "endpoints": [
        "https://github.com/zishan049/taskmanager-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
