{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskManager",
  "version": "0.1.7",
  "identifier": "com.taskmanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TaskManager",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDQTAzNkRFQzc5ODc5RjIKUldUeWVaakgzamFnTE1ROGlHa1pzQThpNFdTRnZxb1hxUEJxVUxXTXMyUzRCdUhESUZKeS8rUFkK",
      "endpoints": [
        "https://github.com/zishan049/taskmanager-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
